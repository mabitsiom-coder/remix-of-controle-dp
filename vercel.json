{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "functions": {
    "server/chunks/**/*.mjs": {
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/.output/server/index.mjs" },
    { "source": "/(.*)", "destination": "/.output/public/$1" }
  ]
}
